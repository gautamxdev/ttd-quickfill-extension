{
  "manifest_version": 3,
  "name": "TTD QuickFill",
  "version": "0.2.0",
  "description": "Fill saved pilgrim details for Sri PAT, SED and Angapradakshinam. Independent extension; review before Continue.",
  "permissions": ["storage", "sidePanel", "debugger", "activeTab", "scripting"],
  "icons": {"16": "icons/ttd-16.png", "32": "icons/ttd-32.png", "48": "icons/ttd-48.png", "128": "icons/ttd-128.png"},
  "host_permissions": ["https://ttdevasthanams.ap.gov.in/*"],
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "side_panel": {"default_path": "panel.html"},
  "action": {"default_title": "TTD QuickFill", "default_icon": {"16": "icons/ttd-16.png", "32": "icons/ttd-32.png", "48": "icons/ttd-48.png", "128": "icons/ttd-128.png"}},
  "content_scripts": [{"matches": ["https://ttdevasthanams.ap.gov.in/*"], "js": ["content.js"], "run_at": "document_idle"}],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"}
}
